{
  "uid": "cvetotishina-operations",
  "title": "ЦветоТишина — эксплуатация",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["cvetotishina"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы API по маршрутам",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "expr": "sum by (route) (rate(cvetotishina_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 задержка API",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cvetotishina_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Доля ошибок 5xx",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "targets": [{ "expr": "sum(rate(cvetotishina_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(cvetotishina_http_requests_total[5m])), 0.001)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Создано заказов",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(increase(cvetotishina_orders_created_total[1h]))", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Оплачено заказов",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum(increase(cvetotishina_orders_paid_total[1h]))", "refId": "A" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Выручка, ₽",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "currencyRUB" }, "overrides": [] },
      "targets": [{ "expr": "sum(increase(cvetotishina_order_revenue_kopecks_total[1h])) / 100", "refId": "A" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Кэш каталога",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum by (result) (rate(cvetotishina_cache_lookups_total[5m]))", "legendFormat": "{{result}}", "refId": "A" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Зависимости и ошибки Redis",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "cvetotishina_dependency_up", "legendFormat": "{{dependency}}", "refId": "A" },
        { "expr": "sum(rate(cvetotishina_redis_failures_total[5m]))", "legendFormat": "Redis errors", "refId": "B" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Outbox: ожидает / dead",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "cvetotishina_outbox_pending", "legendFormat": "pending", "refId": "A" },
        { "expr": "cvetotishina_outbox_dead", "legendFormat": "dead", "refId": "B" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Очередь событий",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "expr": "sum by (queue, state) (cvetotishina_queue_jobs)", "legendFormat": "{{queue}} / {{state}}", "refId": "A" }]
    }
  ]
}
