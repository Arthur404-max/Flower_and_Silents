FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY tests/package.json tests/package.json
RUN npm ci --workspace @cvetotishina/worker
COPY tsconfig.base.json ./
COPY packages/shared packages/shared
COPY apps/worker apps/worker
COPY apps/api/prisma/schema.prisma apps/api/prisma/schema.prisma
RUN npm run build -w @cvetotishina/shared && npx prisma generate --schema apps/api/prisma/schema.prisma && npm run build -w @cvetotishina/worker

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY tests/package.json tests/package.json
RUN npm ci --omit=dev --workspace @cvetotishina/worker && npm cache clean --force
COPY --from=build /app/node_modules/.prisma node_modules/.prisma
COPY --from=build /app/node_modules/@prisma/client node_modules/@prisma/client
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/worker/dist apps/worker/dist
RUN mkdir -p uploads && chown -R node:node /app/uploads
USER node
EXPOSE 3001
CMD ["node", "apps/worker/dist/main.js"]
